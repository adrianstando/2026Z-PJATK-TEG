{
  "name": "teg-2026z-web",
  "version": "0.1.0",
  "private": true,
  "description": "Materiały i prezentacje do laboratoriów TEG (PJATK, 2026Z) — statyczna aplikacja na GitHub Pages",
  "scripts": {
    "predev": "node scripts/check-design-tokens.mjs && node scripts/sync-notebooks.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-design-tokens.mjs && node scripts/sync-notebooks.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-notebooks.mjs",
    "data": "uv run --with tiktoken --with scikit-learn --with numpy --with fastembed scripts/generate_data.py",
    "design:lint": "npx -y @google/design.md lint ../.claude/DESIGN.md"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "^16.3.8",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}

# Skopiuj do .env (NIE commituj .env!) i uzupełnij to, z czego korzystasz.

# Dostawca w notebookach: azure | openai | deepseek | ollama | proxy
LLM_PROVIDER=ollama
# Embeddingi osobno (gdy LLM_PROVIDER=proxy, domyślnie ollama)
# EMBED_PROVIDER=ollama
# Model czatu w Ollamie (domyślnie gemma4:e4b; w Colabie na start gemma3:1b)
# OLLAMA_CHAT=gemma3:1b

# Azure OpenAI (Azure for Students)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

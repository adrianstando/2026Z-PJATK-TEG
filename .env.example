# Skopiuj do .env (NIE commituj .env!) i uzupełnij to, z czego korzystasz.

# Dostawca w notebookach: github | azure | openai | deepseek | ollama | proxy
LLM_PROVIDER=github
# Embeddingi osobno (gdy LLM_PROVIDER=proxy, domyślnie ollama)
# EMBED_PROVIDER=ollama

# GitHub Models: https://github.com/settings/personal-access-tokens (uprawnienie Models: read)
GITHUB_TOKEN=

# Azure OpenAI (Azure for Students)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
